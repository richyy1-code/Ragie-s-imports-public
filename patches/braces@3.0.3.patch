+// Accept bounded trees only, including ASTs supplied directly to the public API.
+const boundedAst = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  const visited = new WeakSet();
+  while (pending.length) {
+    const { node, depth } = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth > 65 || visited.has(node)) {
+      throw new SyntaxError('Brace AST is cyclic or exceeds the safe nesting limit');
+    }
+    visited.add(node);
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push({ node: child, depth: depth + 1 });
+    }
+  }
+  return ast;
+};
